{
  "name": "@agrippa-io/node-mongoose",
  "version": "8.0.2",
  "description": "Mongoose framework layer for Agrippa services",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agrippa-io/node-mongoose.git"
  },
  "keywords": [
    "node",
    "mongoose",
    "framework"
  ],
  "author": "Agrippa Development Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/agrippa-io/node-mongoose/issues"
  },
  "homepage": "https://github.com/agrippa-io/node-mongoose#readme",
  "peerDependencies": {
    "express": "^4.17.1",
    "mongoose": "^8.6.3"
  },
  "dependencies": {
    "@agrippa-io/node-connection-manager": "^1.0.9",
    "@agrippa-io/node-errors": "^1.0.10",
    "@agrippa-io/node-usecase": "^1.0.5",
    "@agrippa-io/node-utils": "^1.0.9",
    "lodash": "^4.17.21",
    "mongoose-batches": "^0.0.2",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^2.12.0",
    "@types/express": "^4.17.21",
    "@types/lodash": "^4.17.7",
    "@types/node": "^22.19.19",
    "@types/uuid": "^8.3.4",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "express": "^4.17.1",
    "mongoose": "^8.6.3",
    "tsc-alias": "^1.8.10",
    "typescript": "~5.3.3",
    "vitest": "^2.1.8"
  }
}
